# Copy this file to .env and fill in your own values.

# --- LLM (ambiguous-passage matching) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional - defaults to a free-tier model if unset.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- Cloud storage (optional) ---
# Leave all four of these blank to keep using the local filesystem (the
# default). Set all four to switch to Cloudflare R2 - required for the
# hosted/multi-device deployment, optional for local use.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Login (optional) ---
# Leave blank for no login (default, fine for local-only use). Set a
# password to require login - needed once this is deployed publicly.
APP_PASSWORD=
# Optional - auto-derived from APP_PASSWORD if unset.
SESSION_SECRET=
